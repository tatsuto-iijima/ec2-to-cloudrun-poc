{
    "name": "tatsuto-iijima/ec2-to-cloudrun-poc",
    "description": "JSON を更新して S3 にアップロードする Web アプリのサンプル（EC2 → Cloud Run 移行 PoC）",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "aws/aws-sdk-php": "^3.300"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
