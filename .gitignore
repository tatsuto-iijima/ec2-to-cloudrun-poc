# Composer
/app/vendor/

# 環境変数（秘匿値を含む）
/.env

# ローカルの DATA_DIR（JSON マスタは成果物ではない）
/data/*
!/data/.gitkeep

# scripts/fs-check.sh の結果（docs/05 に転記する）
/fs-check-results.jsonl

# Terraform
**/.terraform/
# provider の lock は各自の環境（CPU アーキテクチャ）で生成する
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# 認証情報
*.pem
*-key.json

# scripts/update-bench.sh の結果（docs/06 に転記する）
/update-bench-results.jsonl

# scripts/cold-start.sh の結果（docs/07 に転記する）
/cold-start-results.jsonl
/cold-start.log
