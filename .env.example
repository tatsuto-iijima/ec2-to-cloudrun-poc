# docker compose 用の環境変数。cp .env.example .env して使う。.env はコミットしない。

# --- S3（ローカルでは moto の S3 モック。moto は認証情報の値を検証しないので任意の文字列でよい） ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-1
S3_BUCKET=poc-bucket
S3_KEY_PREFIX=

# 実 S3 を使う場合はコメントを外して空にし、上の AWS_* を実際の認証情報に置き換える
# S3_ENDPOINT=

# Cloud Run では AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY を渡さず、SA の ID トークンで IAM ロールを引き受ける（鍵レス）。
# terraform/gcp が Cloud Run の環境変数として設定するので、ローカルでは通常使わない
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/poc-cloudrun-s3-upload
# AWS_WIF_AUDIENCE=            # 空ならロールの ARN
# AWS_ROLE_DURATION_SECONDS=3600
# STS_ENDPOINT=                # STS 互換エンドポイント（moto）。空なら本物
# GCE_METADATA_HOST=metadata.google.internal

# --- アプリ ---
# JSON の書き込み方式: lock（file_put_contents + LOCK_EX。現行アプリと同じ）/ rename（一時ファイル + rename）
WRITE_MODE=lock
DATA_FILE=data.json
# gcsfuse 検証用の診断経路 POST /fs-check を有効にする（Issue #7。ローカルでハーネスを試すときだけ）
# FS_CHECK=1
